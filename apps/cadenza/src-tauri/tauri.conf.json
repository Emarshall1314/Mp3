{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cadenza",
  "version": "0.1.0",
  "identifier": "app.cadenza.player",
  "build": {
    "frontendDist": "../../../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @cadenza/ui dev",
    "beforeBuildCommand": "pnpm --filter @cadenza/ui build"
  },
  "app": {
    "windows": [
      {
        "title": "Cadenza",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: cadenza: http://cadenza.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Music",
    "shortDescription": "Hi-res music player",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "android": {
      "minSdkVersion": 26
    }
  }
}
